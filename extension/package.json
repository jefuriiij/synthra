{
  "name": "synthra-vscode",
  "displayName": "Synthra",
  "description": "Starts Synthra's context engine automatically when you open a project, and shows what it knows in the sidebar: memory, skills and tools, and the helper agents Claude used. Works in VS Code, Antigravity, Cursor, and other VS Code-compatible editors.",
  "version": "0.31.1",
  "publisher": "jefuriiij",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jefuriiij/synthra.git",
    "directory": "extension"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "claude-code",
    "mcp",
    "context-engine",
    "antigravity",
    "cursor"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:synthra.panel"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "synthra",
          "title": "Synthra",
          "icon": "resources/synthra.svg"
        }
      ]
    },
    "views": {
      "synthra": [
        {
          "id": "synthra.learning",
          "name": "Learning"
        },
        {
          "id": "synthra.memory",
          "name": "Memory"
        },
        {
          "id": "synthra.capabilities",
          "name": "Capabilities"
        },
        {
          "id": "synthra.agents",
          "name": "Agents"
        }
      ]
    },
    "commands": [
      {
        "command": "synthra.start",
        "title": "Synthra: Start for this project",
        "category": "Synthra"
      },
      {
        "command": "synthra.stop",
        "title": "Synthra: Stop",
        "category": "Synthra"
      },
      {
        "command": "synthra.restart",
        "title": "Synthra: Restart",
        "category": "Synthra"
      },
      {
        "command": "synthra.openDashboard",
        "title": "Synthra: Open dashboard",
        "category": "Synthra"
      },
      {
        "command": "synthra.showOutput",
        "title": "Synthra: Show log",
        "category": "Synthra"
      },
      {
        "command": "synthra.runDoctor",
        "title": "Synthra: Run doctor",
        "category": "Synthra"
      },
      {
        "command": "synthra.showHealth",
        "title": "Synthra: Show health",
        "category": "Synthra"
      },
      {
        "command": "synthra.repair",
        "title": "Synthra: Repair (re-run syn .)",
        "category": "Synthra"
      },
      {
        "command": "synthra.checkForUpdates",
        "title": "Synthra: Check for updates",
        "category": "Synthra"
      },
      {
        "command": "synthra.panels.refresh",
        "title": "Synthra: Refresh panels",
        "category": "Synthra",
        "icon": "$(refresh)"
      },
      {
        "command": "synthra.panels.open",
        "title": "Synthra: Open",
        "category": "Synthra"
      },
      {
        "command": "synthra.openPanel",
        "title": "Synthra: Open panel",
        "category": "Synthra",
        "icon": {
          "light": "resources/synthra-light.svg",
          "dark": "resources/synthra-dark.svg"
        }
      },
      {
        "command": "synthra.openSettings",
        "title": "Synthra: Settings",
        "category": "Synthra",
        "icon": "$(gear)"
      },
      {
        "command": "synthra.skills.approve",
        "title": "Approve",
        "category": "Synthra",
        "icon": "$(check)"
      },
      {
        "command": "synthra.skills.reject",
        "title": "Reject",
        "category": "Synthra",
        "icon": "$(close)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "synthra.panels.refresh",
          "when": "view =~ /^synthra\\./",
          "group": "navigation@2"
        },
        {
          "command": "synthra.openPanel",
          "when": "view =~ /^synthra\\./",
          "group": "navigation@1"
        },
        {
          "command": "synthra.openSettings",
          "when": "view == synthra.learning",
          "group": "navigation@3"
        }
      ],
      "commandPalette": [
        {
          "command": "synthra.panels.open",
          "when": "false"
        },
        {
          "command": "synthra.skills.approve",
          "when": "false"
        },
        {
          "command": "synthra.skills.reject",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "synthra.openPanel",
          "when": "config.synthra.showEditorButton && activeWebviewPanelId != 'synthra.panel'",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "synthra.skills.approve",
          "when": "view == synthra.learning && viewItem == synthraProposal",
          "group": "inline@1"
        },
        {
          "command": "synthra.skills.reject",
          "when": "view == synthra.learning && viewItem == synthraProposal",
          "group": "inline@2"
        }
      ]
    },
    "configuration": {
      "title": "Synthra",
      "properties": {
        "synthra.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Start Synthra automatically when a folder containing a Synthra project is opened."
        },
        "synthra.requireExistingProject": {
          "type": "boolean",
          "default": true,
          "description": "Only auto-start in folders Synthra already knows (they have a .synthra-graph/ or .synthra/ directory). Turn this off to auto-start in every folder you open — including ones where you have never run `syn .`."
        },
        "synthra.path": {
          "type": "string",
          "default": "syn",
          "description": "Path to the `syn` executable. Leave as `syn` if it is on your PATH."
        },
        "synthra.showDashboardNotification": {
          "type": "boolean",
          "default": false,
          "description": "Show a notification with the dashboard link each time Synthra starts. Off by default — the status bar already shows it."
        },
        "synthra.healthCheckMinutes": {
          "type": "number",
          "default": 5,
          "minimum": 0,
          "description": "How often to re-check Synthra's health while it runs (the status bar turns yellow or red when something is wrong). 0 turns polling off; a check still runs at start and when the window regains focus. The health light needs Synthra 0.32+."
        },
        "synthra.checkForUpdates": {
          "type": "boolean",
          "default": true,
          "description": "Check npm for a newer Synthra once per window and offer to install it. The CLI's own update prompt can't appear under the extension, so without this you are never told."
        },
        "synthra.showEditorButton": {
          "type": "boolean",
          "default": true,
          "description": "Show the Synthra button in the editor's title bar. It opens the large Synthra panel (Memory, Capabilities, Agents) in an editor tab."
        }
      }
    }
  },
  "scripts": {
    "compile": "npm run compile:host && npm run compile:webview",
    "compile:host": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node18",
    "compile:webview": "vite build --logLevel warn",
    "watch": "npm run compile:host -- --watch",
    "check": "tsc --noEmit -p . && svelte-check --tsconfig ./tsconfig.webview.json --threshold warning",
    "package": "npm run compile && vsce package --no-dependencies --allow-missing-repository"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.75.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.28.2",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^5.6.0",
    "vite": "^8.3.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
