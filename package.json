{
  "name": "synthra",
  "version": "0.0.1",
  "description": "Local context engine for AI coding assistants — graph-based context, branch-aware memory, real-time human-activity awareness.",
  "type": "module",
  "bin": {
    "syn": "./bin/syn",
    "synthra": "./bin/syn"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE",
    "ROADMAP.md"
  ],
  "keywords": [
    "claude-code",
    "mcp",
    "context-engine",
    "code-graph",
    "ai-coding",
    "token-savings"
  ],
  "author": "Jeff (@jefuriiij)",
  "license": "MIT",
  "homepage": "https://github.com/jefuriiij/synthra#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jefuriiij/synthra.git"
  },
  "bugs": {
    "url": "https://github.com/jefuriiij/synthra/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "hono": "^4.12.23",
    "sade": "^1.8.1",
    "web-tree-sitter": "^0.26.9"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
